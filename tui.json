{
  "$schema": "https://opencode.ai/tui.json",
  // ============================================================
  // 本文件是「本仓库的本地调试示例」，不是 OpenCode 的真实配置。
  // 真实配置位置（二选一）：
  //   全局：~/.config/opencode/tui.json
  //   项目：<你的项目>/.opencode/tui.json
  // 把下面 plugin 数组里的一行原样复制过去即可（注意改成绝对路径）。
  // ============================================================
  "plugin": [
  // 方案 A（推荐调试）：相对路径文件插件。
  // 以「声明这份 tui.json 的文件」为基准解析，./src/panel.tsx 即本仓库入口。
  // 文件模块必须 default export { id, tui }，且 id 非空（见 src/panel.tsx）。
  // 注意：入口只做 slots.register，渲染逻辑在 components/TimelinePanel（入口在宿主里常驻，逻辑放入口会越改越旧）。
  [
    "./src/panel.tsx",
      {
        // 下面是透传给 tui(api, options) 的第二个参数 options，插件侧可读。
        // 先占位，阶段 4 的 index.tsx 会读取它们。
        "position": "sidebar",
        "maxItems": 50
      }
    ]
    // 方案 B（发布 npm 后）：包 spec 写法，取消注释并删除方案 A 即可。
    // 前提：package.json 已有 exports["./tui"] 且已 `opencode plugin <包名>` 安装过。
    // "opencode-timeline-plugin@latest"
  ],
  // 按插件 id 开关（默认全启用）。文件插件的 id 来自模块 export 的 id。
  // 例：关闭本插件 -> { "timeline.viewer": false }
  "plugin_enabled": {}
}
